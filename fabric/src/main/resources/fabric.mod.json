{
	"schemaVersion": 1,
	"id": "inventory_shulker",
	"version": "${version}",
	"name": "Auto Shulker Inventory",
	"description": "Automatically stores items in shulker boxes when inventory is full. Compatible with Minecraft 1.21 through 1.21.8",
	"authors": [
		"DennisTheGamer"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/auto-shulker-inventory",
		"issues": "https://github.com/DennisTheGamer/auto-shulker-inventory/issues"
	},
	"license": "MIT",
	"icon": "assets/inventory_shulker/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.autoshulker.fabric.AutoShulkerInventoryFabric"
		],
		"client": [
			"com.autoshulker.fabric.AutoShulkerInventoryFabricClient"
		],
		"modmenu": [
			"com.autoshulker.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"inventory_shulker.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": ">=1.21 <=1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"cloth-config": ">=15.0.0"
	}
}
