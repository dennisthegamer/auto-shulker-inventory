{
	"schemaVersion": 1,
	"id": "inventory_shulker",
	"version": "${version}",
	"name": "Auto Shulker Inventory Loader",
	"description": "Automatically stores items in shulker boxes when inventory is full.",
	"authors": [
		"Dennis_thegamer"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/auto-shulker-inventory",
		"issues": "https://github.com/DennisTheGamer/auto-shulker-inventory/issues"
	},
	"license": "MIT",
	"icon": "assets/inventory_shulker/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"de.dennisthegamer.autoshulkerinventory.AutoShulkerInventory"
		],
		"client": [
			"de.dennisthegamer.autoshulkerinventory.AutoShulkerInventoryClient"
		],
		"modmenu": [
			"de.dennisthegamer.autoshulkerinventory.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"inventory_shulker.mixins.json"
	],
	 "depends": {
		"fabricloader": ">=0.19.2",
		"fabric-api": "*",
		"minecraft": "~26.2-",
		"java": ">=25"
   },
	"suggests": {
		"modmenu": ">=20.0.0",
		"yet_another_config_lib": ">=3.9.4"
	}
}
